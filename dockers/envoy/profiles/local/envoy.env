# Local k3d/desktop Envoy profile.
# These values are intentionally reachable inside the k3d namespace and keep
# http://localhost:8888 working without local TLS certificates.

ENVOY_GATEWAY_PROFILE=local

# Keycloak settings
ENVOY_JWT_ISSUER=http://keycloak.master-go-cqrs.svc.cluster.local:8080/realms/backend
ENVOY_JWKS_URI=http://keycloak:8080/realms/backend/protocol/openid-connect/certs
ENVOY_JWT_AUDIENCE=master-go-cqrs
KEYCLOAK_ISSUER=http://keycloak.master-go-cqrs.svc.cluster.local:8080/realms/backend
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/backend/protocol/openid-connect/certs
KEYCLOAK_CLUSTER_ADDRESS=keycloak
KEYCLOAK_CLUSTER_PORT=8080

# External Authorization settings
EXT_AUTHZ_URI=http://user:8889

# Backend API HTTP cluster settings
API_HTTP_ADDRESS=user
API_HTTP_PORT=8889

# Swagger UI cluster settings (REST docs)
SWAGGER_UI_REST_ADDRESS=swagger-ui-rest
SWAGGER_UI_REST_PORT=8080

# Swagger UI cluster settings (gRPC docs)
SWAGGER_UI_GRPC_ADDRESS=swagger-ui-grpc
SWAGGER_UI_GRPC_PORT=8080

# gRPC service cluster settings
PAYMENT_GRPC_ADDRESS=payment
PAYMENT_GRPC_PORT=9081
PAYMENT_HTTP_ADDRESS=payment
PAYMENT_HTTP_PORT=8081
AFFILIATE_GRPC_ADDRESS=affiliate
AFFILIATE_GRPC_PORT=9082
SETTLEMENT_GRPC_ADDRESS=settlement
SETTLEMENT_GRPC_PORT=9083
AGENT_GRPC_ADDRESS=agent
AGENT_GRPC_PORT=9084

# Observability
OTEL_GRPC_ADDRESS=otel
OTEL_GRPC_PORT=4317
