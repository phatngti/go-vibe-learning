# Production Envoy profile.
# Override these values from your deployment system. This file documents the
# required production contract and prevents local k3d defaults from leaking into
# prod rendering.

ENVOY_GATEWAY_PROFILE=prod

# Public listener TLS. Required when ENVOY_GATEWAY_PROFILE=prod.
ENVOY_TLS_CERT_FILE=/etc/envoy/tls/tls.crt
ENVOY_TLS_KEY_FILE=/etc/envoy/tls/tls.key

# OIDC/JWT settings. Set issuer to the externally valid Keycloak realm URL.
ENVOY_JWT_ISSUER=https://keycloak.example.com/realms/backend
ENVOY_JWKS_URI=https://keycloak.example.com/realms/backend/protocol/openid-connect/certs
ENVOY_JWT_AUDIENCES=master-go-cqrs
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/backend
KEYCLOAK_JWKS_URI=https://keycloak.example.com/realms/backend/protocol/openid-connect/certs
KEYCLOAK_CLUSTER_ADDRESS=keycloak.master-go-cqrs.svc.cluster.local
KEYCLOAK_CLUSTER_PORT=8080

# Internal service DNS. Replace with the production service discovery names if
# they differ from the Kubernetes service names below.
EXT_AUTHZ_URI=http://user.master-go-cqrs.svc.cluster.local:8889
API_HTTP_ADDRESS=user.master-go-cqrs.svc.cluster.local
API_HTTP_PORT=8889
SWAGGER_UI_REST_ADDRESS=swagger-ui-rest.master-go-cqrs.svc.cluster.local
SWAGGER_UI_REST_PORT=8080
SWAGGER_UI_GRPC_ADDRESS=swagger-ui-grpc.master-go-cqrs.svc.cluster.local
SWAGGER_UI_GRPC_PORT=8080
PAYMENT_GRPC_ADDRESS=payment.master-go-cqrs.svc.cluster.local
PAYMENT_GRPC_PORT=9081
AFFILIATE_GRPC_ADDRESS=affiliate.master-go-cqrs.svc.cluster.local
AFFILIATE_GRPC_PORT=9082
SETTLEMENT_GRPC_ADDRESS=settlement.master-go-cqrs.svc.cluster.local
SETTLEMENT_GRPC_PORT=9083
AGENT_GRPC_ADDRESS=agent.master-go-cqrs.svc.cluster.local
AGENT_GRPC_PORT=9084

# Observability
OTEL_GRPC_ADDRESS=otel.master-go-cqrs.svc.cluster.local
OTEL_GRPC_PORT=4317
